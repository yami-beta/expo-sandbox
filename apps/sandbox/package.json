{
  "name": "sandbox",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "pnpm run lint:oxlint && pnpm run lint:expo && pnpm run lint:oxfmt",
    "lint:oxlint": "pnpm run generate-types && oxlint --type-aware --type-check",
    "lint:expo": "expo lint",
    "lint:oxfmt": "oxfmt . --check",
    "format": "oxfmt . --write",
    "generate-types": "expo customize tsconfig.json",
    "lingui:extract": "lingui extract --clean",
    "lingui:compile": "lingui compile",
    "lingui:compile-if-needed": "[ -f src/locales/en/messages.ts ] || pnpm run lingui:compile",
    "lingui:check": "lingui compile --strict"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/metro-runtime": "~57.0.3",
    "@expo/ui": "~57.0.4",
    "@formatjs/intl-locale": "^5.3.3",
    "@formatjs/intl-pluralrules": "^6.3.3",
    "@formatjs/intl-relativetimeformat": "^12.3.3",
    "@lingui/core": "^6.0.0",
    "@lingui/react": "^6.0.0",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@react-native-vector-icons/material-icons": "^13.1.2",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-localization": "~57.0.0",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@lingui/babel-plugin-lingui-macro": "^6.0.0",
    "@lingui/cli": "^6.0.0",
    "@lingui/format-po": "^6.0.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.0",
    "eslint-plugin-oxlint": "^1.66.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "tooling": "workspace:*",
    "typescript": "~6.0.3"
  }
}
